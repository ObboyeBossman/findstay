# Render PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/findstay
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Supabase Auth (JWKS Verification + Optional Admin Lookup)
SUPABASE_JWKS_URI=
SUPABASE_JWT_ISSUER=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PII Encryption — Ghana Data Protection Act 843 (NFR-28, TA-09, P-12)
# Generate with: openssl rand -base64 32
# Must be a Base64-encoded 256-bit (32-byte) AES key; app will refuse to start if absent or malformed.
FINDSTAY_PII_ENCRYPTION_KEY=

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=findstay-property-images
R2_PRIVATE_BUCKET=findstay-verification-docs
R2_PUBLIC_CDN_URL=
