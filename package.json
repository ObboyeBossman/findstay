{
  "name": "findstay",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "showcase"
  ],
  "scripts": {
    "dev": "npm run dev -w @findstay/web",
    "dev:showcase": "npm run dev -w @findstay/showcase",
    "build": "npm run lint:theme && npm run build -w @findstay/web",
    "build:showcase": "npm run build -w @findstay/showcase",
    "typecheck": "npm run typecheck -w @findstay/web",
    "sync:project": "node scripts/sync-project.mjs",
    "lint:theme": "node scripts/check-theme.mjs",
    "check": "npm run lint:theme && npm run typecheck"
  }
}
